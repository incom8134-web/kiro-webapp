# Starts the wheel node and twist_mux at power-on. See deploy/README.md.
[Unit]
Description=KIRO wheel base (mecanum_base_node + twist_mux)
After=network-online.target

[Service]
User=YOUR_USER
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/YOUR_USER/ros2_ws/install/setup.bash && exec ros2 launch /home/YOUR_USER/kiro-webapp/deploy/kiro_base.launch.py'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
